org.springframework.boot.autoconfiguration.EnabledAutoConfiguration=\
com.example.bootstartdemo.configuration.BackgroundConfiguration
org.springframework.boot.env.EnvironmentPostProcessor=\
com.example.bootstartdemo.configuration.analyzer.PropertiesGuardEnvironmentPostProcessor
org.springframework.boot.diagnostics.FailureAnalyzer=\
com.example.bootstartdemo.configuration.analyzer.BackgroundTaskPropertyFailureAnalyzer